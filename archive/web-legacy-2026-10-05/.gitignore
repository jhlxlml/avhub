*.ogv
# Do not ignore *.ts: TypeScript source uses that extension.

# Generated web, Electron, TypeScript and packaging outputs
/app/static/
/app/build-info.json
/electron/dist/
/dist/
/build/
*.tsbuildinfo
/vite.config.js
/vite.config.d.ts
*.spec
*.exe
*.dll
*.pyd

# FFmpeg executables are local dependencies; retain redistribution notices
/bin/*
!/bin/FFmpeg-LICENSE.txt
!/bin/FFmpeg-BUILD-INFO.txt

# Test reports, coverage, logs and temporary/backup files
/test-results/
/playwright-report/
coverage/
htmlcov/
.coverage
.coverage.*
coverage.xml
.nyc_output/
*.log
*.log.*
*.tmp
*.temp
*.bak
*.zip
*.7z
*.rar
*.tar
*.gz

# Private environment values, keys and local editor/agent state
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.pfx
*.p12
/.codex/
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini
