# Dependencies and interpreter/tool caches
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Local media library, saved screenshots, portable application data
/data/
AVHub-data/
screenshots/
frame-inspection/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Personal media files are never source assets for this repository
*.mp4
*.m4v
*.mkv
*.avi
*.mov
*.webm
*.wmv
*.flv
*.mts
*.m2ts
*.mpeg
*.mpg
*.vob
